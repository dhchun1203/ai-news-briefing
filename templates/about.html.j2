<!DOCTYPE html>
{# 소개 페이지(/about). 루트에 있으므로 자산 접두사가 없다(/glossary와 같은 깊이). #}
{% set title_ko = "소개 · Daily AI Thread" %}
{% set title_en = "About · Daily AI Thread" %}
{% set desc_ko = about.tagline_ko %}
{% set desc_en = about.tagline_en %}
<html lang="{{ lang }}" data-lang="{{ lang }}"
      data-default-lang="{{ lang }}" data-asset-prefix="{{ up }}" data-archive-prefix="{{ lup }}archive/">
<head>
<meta charset="UTF-8">
<title>{{ title_ko if lang == 'ko' else title_en }}</title>
<meta name="description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title_ko if lang == 'ko' else title_en }}">
<meta property="og:description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title_ko if lang == 'ko' else title_en }}">
<meta name="twitter:description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta name="robots" content="index, follow">
{% if hreflang_ko_url and hreflang_en_url %}
<link rel="alternate" hreflang="ko" href="{{ hreflang_ko_url }}">
<link rel="alternate" hreflang="en" href="{{ hreflang_en_url }}">
<link rel="alternate" hreflang="x-default" href="{{ hreflang_ko_url }}">
{% endif %}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{% if lang == 'ko' %}AI 뉴스 브리핑 · Daily AI Thread{% else %}Daily AI Thread · AI News Briefing{% endif %}">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="icon" type="image/svg+xml" href="{{ up }}favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="{{ up }}favicon.png">
<link rel="alternate" type="application/rss+xml" title="{% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}" href="{{ lup }}feed.xml">
{% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
{% if naver_site_verification %}<meta name="naver-site-verification" content="{{ naver_site_verification }}">{% endif %}
<script type="application/ld+json">{{ jsonld|tojson }}</script>
<script>
(function () {
  // 테마만 처리한다. 언어는 URL이 결정하므로(한 페이지 = 한 언어) 클라이언트에서
  // 바꾸지 않는다 — 예전에는 localStorage 값으로 본문을 갈아끼웠는데, 그러면 크롤러가
  // 보는 언어와 사람이 보는 언어가 달라질 수 있다.
  function getCookie(name) {
    var match = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }
  try {
    // 처음 방문(쿠키 없음)이면 시스템 설정과 무관하게 항상 라이트 모드로 뜬다.
    var t = getCookie("theme");
    if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap">
<link rel="stylesheet" href="{{ up }}site-base.css">
<link rel="stylesheet" href="{{ up }}site-mobile.css" media="(max-width: 767px)">
<link rel="stylesheet" href="{{ up }}site-desktop.css" media="(min-width: 768px)">
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">
  {% if lang == 'ko' %}본문으로 건너뛰기{% else %}Skip to content{% endif %}
</a>
<header class="site-header">
  {% set nav_p = lup %}
  {% set nav_current = 'about' %}
  {% include '_utility-bar.html.j2' %}
  <div class="header-inner">
    <h1>
      <a href="{{ lup }}index.html">
        {% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}
      </a>
    </h1>
    <p class="tagline">
      {% if lang == 'ko' %}소개{% else %}About{% endif %}
    </p>
  </div>
</header>

<main class="content" id="main-content">
  <nav class="breadcrumb" aria-label="현재 위치" data-aria-ko="현재 위치" data-aria-en="Breadcrumb">
    <a href="{{ lup }}index.html">{% if lang == 'ko' %}홈{% else %}Home{% endif %}</a>
    <span class="breadcrumb-sep" aria-hidden="true">›</span>
    <span class="breadcrumb-current">{% if lang == 'ko' %}소개{% else %}About{% endif %}</span>
  </nav>

  {# 사이트 정체성 한 문장. 이 문장은 홈 description·Organization 스키마·RSS 설명과
     같은 내용을 유지한다 — 채널마다 설명이 다르면 이 사이트가 무엇인지 확정하기 어렵다. #}
  <p class="about-lede">
    {% if lang == 'ko' %}{{ about.tagline_ko }}{% else %}{{ about.tagline_en }}{% endif %}
  </p>

  {# 앵커가 있는 섹션만 id를 갖는다 — 다른 페이지의 공유 안내 줄이 /about#sharing으로
     바로 이 자리를 연다. #}
  {% for s in about.sections %}
  <section class="about-section"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}>
    <h2 class="about-heading">
      {% if lang == 'ko' %}{{ s.heading_ko }}{% else %}{{ s.heading_en }}{% endif %}
    </h2>
    <p class="about-body">
      {% if lang == 'ko' %}{{ s.body_ko }}{% else %}{{ s.body_en }}{% endif %}
    </p>
  </section>
  {% endfor %}

  {% if site_stats and site_stats.days %}
  <p class="site-stats about-stats">
    {% if lang == 'ko' %}브리핑 {{ site_stats.days }}일 · 기사 {{ site_stats.articles }}건 · 용어 {{ site_stats.terms }}개{% if site_stats.since %} · {{ site_stats.since }}부터{% endif %}{% else %}{{ site_stats.days }} editions · {{ site_stats.articles }} stories · {{ site_stats.terms }} terms{% if site_stats.since %} · since {{ site_stats.since }}{% endif %}{% endif %}
  </p>
  {% endif %}

  <section class="about-section">
    <h2 class="about-heading">
      {% if lang == 'ko' %}{{ about.contact_label_ko }}{% else %}{{ about.contact_label_en }}{% endif %}
    </h2>
    <p class="about-body">
      <a href="{{ about.contact_url }}" target="_blank" rel="noopener noreferrer">{{ about.contact_url }}</a>
    </p>
  </section>
</main>

<footer class="site-footer">
  <p>
    {% if lang == 'ko' %}매일 08:00 KST 자동 갱신 · 마지막 생성: {{ generated_at }}{% else %}Auto-updated daily at 08:00 KST · Last updated: {{ generated_at }}{% endif %}
  </p>
  {# 사내 공유를 막는 것은 관심이 아니라 "이거 옮겨도 되나"라는 멈춤이다.
     그 답을 찾아 헤매지 않게 모든 페이지 푸터에 한 줄로 둔다. 조건은 /about#sharing. #}
  <p class="share-permit">
    {% if lang == 'ko' %}사내 공유·인용 자유롭게 하셔도 됩니다{% else %}Free to share internally or cite with a link{% endif %}
    <a class="share-permit-link" href="{{ lup }}about.html#sharing">{% if lang == 'ko' %}자세히{% else %}details{% endif %}</a>
  </p>
  <p class="footer-links">
    <a href="{{ lup }}feed.xml">RSS</a>
    <span aria-hidden="true">·</span>
    <a href="{{ lup }}topics/index.html">{% if lang == 'ko' %}주제별 보기{% else %}Topics{% endif %}</a>
    <span aria-hidden="true">·</span>
    <a href="{{ lup }}glossary.html">{% if lang == 'ko' %}용어사전{% else %}Glossary{% endif %}</a>
  </p>
</footer>

<script defer src="{{ up }}site.js"></script>
</body>
</html>
