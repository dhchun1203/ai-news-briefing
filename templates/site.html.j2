<!DOCTYPE html>
{% set title_ko = "AI 뉴스 브리핑 — " + date + (" (지난 기록)" if is_archive else "") %}
{% set title_en = "AI News Briefing — " + date + (" (Archive)" if is_archive else "") %}
{% set desc_ko = date + "자 AI 뉴스 요약과 시사점" %}
{% set desc_en = "Daily AI news summaries and takeaways — " + date %}
{% set title_default = title_en if lang == 'en' else title_ko %}
{% set desc_default = desc_en if lang == 'en' else desc_ko %}
<html lang="{{ lang }}" data-lang="{{ lang }}"
      data-default-lang="{{ lang }}" data-asset-prefix="{{ css_prefix }}" data-archive-prefix="{{ archive_link_prefix }}">
<head>
<meta charset="UTF-8">
<title>{{ title_default }}</title>
<meta name="description" content="{{ desc_default }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title_default }}">
<meta property="og:description" content="{{ desc_default }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title_default }}">
<meta name="twitter:description" content="{{ desc_default }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta name="robots" content="index, follow">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{% if lang == 'ko' %}AI 뉴스 브리핑 · Daily AI Thread{% else %}Daily AI Thread · AI News Briefing{% endif %}">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="icon" type="image/svg+xml" href="{{ css_prefix }}favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="{{ css_prefix }}favicon.png">
<link rel="alternate" type="application/rss+xml" title="{{ title_default }}" href="{{ feed_href }}">
{% if hreflang_ko_url and hreflang_en_url %}
<link rel="alternate" hreflang="ko" href="{{ hreflang_ko_url }}">
<link rel="alternate" hreflang="en" href="{{ hreflang_en_url }}">
<link rel="alternate" hreflang="x-default" href="{{ hreflang_ko_url }}">
{% endif %}
{% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
{% if naver_site_verification %}<meta name="naver-site-verification" content="{{ naver_site_verification }}">{% endif %}
<script type="application/ld+json">{{ jsonld|tojson }}</script>
<script>
(function () {
  // 테마만 처리한다. 언어는 URL이 결정하므로(한 페이지 = 한 언어) 클라이언트에서
  // 바꾸지 않는다 — 예전에는 localStorage 값으로 본문을 갈아끼웠는데, 그러면 크롤러가
  // 보는 언어와 사람이 보는 언어가 달라질 수 있다.
  function getCookie(name) {
    var match = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }
  try {
    // 처음 방문(쿠키 없음)이면 시스템 설정과 무관하게 항상 라이트 모드로 뜬다.
    var t = getCookie("theme");
    if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap">
<link rel="stylesheet" href="{{ css_prefix }}site-base.css">
<link rel="stylesheet" href="{{ css_prefix }}site-mobile.css" media="(max-width: 767px)">
<link rel="stylesheet" href="{{ css_prefix }}site-desktop.css" media="(min-width: 768px)">
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">
  {% if lang == 'ko' %}본문으로 건너뛰기{% else %}Skip to content{% endif %}
</a>
<header class="site-header">
  {# 이 템플릿은 홈(index.html)과 일자별 페이지(archive/<날짜>.html)를 둘 다 그린다.
     일자별 페이지는 "아카이브" 섹션 안이므로 생성기가 nav_current='archive'를 넘긴다. #}
  {% set nav_p = lang_prefix %}
  {% include '_utility-bar.html.j2' %}
  <div class="header-inner">
    <h1>
      <a href="{{ lang_prefix }}index.html">
        {% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}
      </a>
    </h1>
    <p class="tagline">
      {% if lang == 'ko' %}매일 아침 8시 · AI 기사 {{ articles|length }}건의 요약과 시사점{% else %}Daily at 8AM KST · Summaries and takeaways from {{ articles|length }} AI articles{% endif %}
    </p>
    <p class="mission">
      {% if lang == 'ko' %}
        <span class="mission-para">TechCrunch·VentureBeat 같은 업계 매체, OpenAI·Google DeepMind의 공식 발표, MarkTechPost·MIT Technology Review 같은 기술 전문 매체, Hacker News의 커뮤니티 신호까지 — 서로 다른 관점을 매일 교차 확인합니다.</span>
        <span class="mission-para mission-emphasis">"무슨 일이 있었는지"보다 "왜 중요한지"를 짚어, 흩어진 뉴스를 하루 단위로 이어지는 흐름으로 읽을 수 있게 하는 것이 이 브리핑의 목표입니다.</span>
      {% else %}
        <span class="mission-para">We cross-check industry press (TechCrunch, VentureBeat), official lab announcements (OpenAI, Google DeepMind), technical outlets (MarkTechPost, MIT Technology Review), and community signal from Hacker News — deliberately mixing perspectives instead of trusting a single narrative.</span>
        <span class="mission-para mission-emphasis">The goal isn't just what happened, but why it matters, so scattered daily headlines add up to a coherent read on where AI is heading.</span>
      {% endif %}
    </p>
    {% if site_stats and site_stats.days %}
    {# 구독자 수 대신 '얼마나 꾸준히 나왔는가'를 보여준다 — 규모가 작을 때도 정직하게
       쌓이는 신뢰 신호이고, 시작 시점부터 스스로 늘어나서 손댈 일이 없다. #}
    <p class="site-stats">
      {# "하루도 빠짐없이"는 days 숫자와 다른 주장이다 — days는 발행한 날 수라 하루
         걸러도 안 늘 뿐이지만, 이 문구는 결번이 없다고 단언한다. 둘을 묶어두면 하루
         거른 뒤에도 문구가 그대로 나가 거짓말이 되므로 unbroken일 때만 붙인다.
         결번이 생겨도 시작일은 사실이므로 그건 남긴다. #}
      {% if lang == 'ko' %}브리핑 {{ site_stats.days }}일 · 기사 {{ site_stats.articles }}건 · 용어 {{ site_stats.terms }}개{% if site_stats.since %} · {{ site_stats.since }}부터{% if site_stats.unbroken %} 하루도 빠짐없이{% endif %}{% endif %}{% else %}{{ site_stats.days }} editions · {{ site_stats.articles }} stories · {{ site_stats.terms }} terms explained{% if site_stats.since %} · {% if site_stats.unbroken %}every day since{% else %}since{% endif %} {{ site_stats.since }}{% endif %}{% endif %}
      {# 이 숫자들이 무엇을 세는지, 우리가 무엇을 골랐는지 그대로 볼 수 있는 곳.
         내비게이션에는 넣지 않는다 — 매일 읽는 사람에게 필요한 메뉴가 아니라
         "이 사이트를 믿어도 되나"를 확인하러 오는 사람이 한 번 보는 페이지다. #}
      <span class="stats-sep" aria-hidden="true">·</span>
      <a class="stats-data-link" href="{{ lang_prefix }}data.html">{% if lang == 'ko' %}무엇을 골랐나 →{% else %}what we picked →{% endif %}</a>
    </p>
    {% endif %}
  </div>
</header>

<main class="content" id="main-content">
  <div class="date-bar">
    <span class="date-label">{{ date }}</span>
    {% if reading_minutes_ko %}
    <span class="reading-time">
      {% if lang == 'ko' %}· 약 {{ reading_minutes_ko }}분 분량{% else %}· ~{{ reading_minutes_en }} min read{% endif %}
    </span>
    {% endif %}
    {% if is_archive %}
      <span class="badge archive-badge">
        {% if lang == 'ko' %}지난 기록{% else %}Past Edition{% endif %}
      </span>
      <a class="back-link" href="{{ home_link }}">
        {% if lang == 'ko' %}오늘자 브리핑 보기 →{% else %}View today's briefing →{% endif %}
      </a>
    {% endif %}
  </div>
  {# 기사 순서가 무작위가 아니라 중요도순이라는 것을 알린다. GeekNews 피드백 2차에서
     "왜 이 순서인지 모르겠다"는 지적이 있었다.

     후보 수는 그날 실제로 모은 숫자다(fetch_articles.py의 candidates_total).
     이 값이 없는 날 — 이 필드가 생기기 전 아카이브 — 은 숫자를 지어내지 않고
     "수십 건"으로 떨어진다. 실측 표본(2026-08-06)이 70건이라 "수백 건"은 과장이다. #}
  {% if articles %}
  <p class="selection-note">
    {% if lang == 'ko' %}
      {% if candidates_total %}후보 {{ candidates_total }}건에서 고른 {{ articles|length }}건{% else %}수십 건에서 고른 오늘의 {{ articles|length }}건{% endif %} · 중요한 순서로 배열
    {% else %}
      {% if candidates_total %}{{ articles|length }} picked from {{ candidates_total }} candidates{% else %}{{ articles|length }} picked from dozens of stories{% endif %} · ordered by significance
    {% endif %}
  </p>
  {% endif %}

  {% if show_weekly_banner and weekly_labels %}
  <a class="weekly-teaser" href="{{ weekly_link_prefix }}{{ weekly_labels[0] }}.html">
    <span class="weekly-teaser-label">
      {% if lang == 'ko' %}주간 회고 · {{ weekly_labels[0] }}{% else %}Weekly Recap · {{ weekly_labels[0] }}{% endif %}
    </span>
    <span class="weekly-teaser-headline">
      {% if lang == 'ko' %}이번 주 AI 흐름 정리 보기{% else %}This week's AI trends, summarized{% endif %}
    </span>
  </a>
  {% endif %}

  {% if not articles %}
  <p class="empty-state">
    {% if lang == 'ko' %}오늘은 조건에 맞는 기사를 찾지 못했습니다.{% else %}No qualifying articles were found today.{% endif %}
  </p>
  {% endif %}

  {% if daily_insight %}
  <section class="insight" aria-label="오늘의 인사이트" data-aria-ko="오늘의 인사이트" data-aria-en="Today's insight">
    <p class="insight-label">
      {% if lang == 'ko' %}오늘의 인사이트{% else %}Today's Insight{% endif %}
    </p>
    <h2 class="insight-headline">
      {% if lang == 'ko' %}{{ daily_insight.headline_ko|safe }}{% else %}{{ daily_insight.headline_en|safe }}{% endif %}
    </h2>
    <div class="insight-body">
      <div>{% if lang == 'ko' %}
        {% for para in daily_insight.paragraphs_ko %}<p>{{ para|safe }}</p>{% endfor %}
      {% else %}
        {% for para in daily_insight.paragraphs_en %}<p>{{ para|safe }}</p>{% endfor %}
      {% endif %}</div>
    </div>
    {% if daily_insight.watch_ko %}
    <p class="insight-watch">
      <span class="insight-watch-label">
        {% if lang == 'ko' %}지켜볼 신호{% else %}Signal to watch{% endif %}
      </span>
      {% if lang == 'ko' %}{{ daily_insight.watch_ko|safe }}{% else %}{{ daily_insight.watch_en|safe }}{% endif %}
    </p>
    {% endif %}
  </section>
  {% endif %}

  {% include '_subscribe-box.html.j2' %}

  {# ---------- 이 브리핑이 어떻게 만들어지나 ----------
     목차 바로 위. 독자가 "오늘 뭘 읽을까"를 정하기 직전에, 이 10건이 어디서 나왔는지를
     한 번 보여준다. 통계 줄 끝의 작은 링크 하나로는 이 페이지가 있다는 걸 알기 어려웠다.

     처음에는 데스크톱 우측 여백에 고정 배치했는데 본문 흐름 밖이라 눈에 안 들어왔고,
     좁은 화면에서는 아예 보이지 않았다. 본문 안으로 들여 모든 폭에서 보이게 한다.

     데이터가 없으면 렌더링하지 않는다. #}
  {% if site_data and site_data.article_total %}
  <aside class="data-card" aria-label="{% if lang == 'ko' %}이 사이트가 무엇을 골랐나{% else %}What this site picked{% endif %}">
    <p class="data-card-title">
      {% if lang == 'ko' %}무엇을 골랐나{% else %}What we picked{% endif %}
    </p>
    {% if site_data.funnel %}
    {# 퍼널이 기록된 날에는 그 하루의 좁혀짐을 보여준다 — 이 사이트의 과정을 한 줄로
       설명하는 가장 강한 숫자다. 기록 전 날짜에는 이 블록이 빠진다. #}
    <p class="data-card-flow">
      <span class="data-card-big">{{ "{:,}".format(site_data.funnel.entries_seen) }}</span>
      <span class="data-card-unit">{% if lang == 'ko' %}건을 훑어{% else %}scanned{% endif %}</span>
      <span class="data-card-arrow" aria-hidden="true">→</span>
      <span class="data-card-big data-card-big-accent">{{ site_data.funnel.selected }}</span>
      <span class="data-card-unit">{% if lang == 'ko' %}건{% else %}published{% endif %}</span>
    </p>
    {% endif %}
    <ul class="data-card-bars">
      {% for s in site_data.sources[:4] %}
      <li>
        <span class="data-card-label">{% if s.is_others %}{% if lang == 'ko' %}기타{% else %}others{% endif %}{% else %}{{ source_label(s.key, lang) }}{% endif %}</span>
        <span class="data-card-track"><span class="data-card-fill{% if s.is_others %} data-card-fill-muted{% endif %}" style="width: {{ s.percent }}%"></span></span>
        <span class="data-card-pct">{{ s.percent }}%</span>
      </li>
      {% endfor %}
    </ul>
    <p class="data-card-meta">
      {% if lang == 'ko' %}{{ site_data.day_count }}일 · 기사 {{ site_data.article_total }}건 · 용어 {{ site_data.term_total }}개{% else %}{{ site_data.day_count }} days · {{ site_data.article_total }} stories · {{ site_data.term_total }} terms{% endif %}
    </p>
    <a class="data-card-link" href="{{ lang_prefix }}data.html">
      {% if lang == 'ko' %}전체 데이터 보기 →{% else %}See the full data →{% endif %}
    </a>
  </aside>
  {% endif %}

  {% if articles %}
  <nav class="toc" aria-label="목차" data-aria-ko="목차" data-aria-en="Table of contents">
    <h2 class="toc-title">
      {% if lang == 'ko' %}목차{% else %}Contents{% endif %}
    </h2>
    <ol class="toc-list">
      {% for article in articles %}
      <li><a href="#article-{{ loop.index }}"><span class="toc-num">{{ "%02d"|format(loop.index) }}</span><span class="toc-text">{% if lang == 'en' and article.title_en %}{{ article.title_en }}{% else %}{{ article.title }}{% endif %}</span></a></li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  <div class="article-list">
    {% for article in articles %}
    <article class="article-card" id="article-{{ loop.index }}">
      <div class="article-meta">
        {# 중요도 순번. 1~10 전부 같은 무게로 표시한다 — 상위만 강조하면 아래쪽
           기사가 덤처럼 보이는데, 10건 모두 선별을 통과한 기사다. #}
        <span class="article-rank" aria-hidden="true">{{ "%02d"|format(loop.index) }}</span>
        <span class="source">{{ source_label(article.source, lang) }}</span>
        {% if article.source_type == "primary" %}
        <span class="badge source-badge source-badge-primary">
          {% if lang == 'ko' %}공식 발표{% else %}Official{% endif %}
        </span>
        {% elif article.source_type == "community" %}
        <span class="badge source-badge source-badge-community">
          {% if lang == 'ko' %}커뮤니티{% else %}Community{% endif %}
        </span>
        {% else %}
        <span class="badge source-badge source-badge-press">
          {% if lang == 'ko' %}보도{% else %}Press{% endif %}
        </span>
        {% endif %}
        {% if article.cross_source_count and article.cross_source_count >= 2 %}
        {# 여러 매체가 같은 사건을 동시에 다뤘다는 신호. 이 수치는 기사를 고를 때 이미
           쓰이는데(fetch_articles.py) 지금까지 화면에 드러나지 않았다. 1은 우연히
           겹친 경우가 많아 노이즈라 2부터만 표시한다. #}
        <span class="badge coverage-badge">
          {% if lang == 'ko' %}{{ article.cross_source_count }}개 매체 동시 보도{% else %}Covered by {{ article.cross_source_count }} more outlets{% endif %}
        </span>
        {% endif %}
        <span class="dot">·</span>
        <span class="published">{{ article.published_at[:10] }}</span>
        {# 기사별 읽는 시간. 전부 1분 미만이라 "분"으로 반올림하면 10건이 모두 "1분"이
           되어 정보가 안 된다 — generate_site.reading_time이 90초 미만은 초로 준다. #}
        {% set rt = article.reading_ko if lang == 'ko' else article.reading_en %}
        {% if rt and rt.value %}
        <span class="dot">·</span>
        <span class="article-reading-time">
          {%- if lang == 'ko' -%}
            약 {{ rt.value }}{% if rt.unit == 'sec' %}초{% else %}분{% endif %}
          {%- else -%}
            ~{{ rt.value }}{% if rt.unit == 'sec' %}s{% else %} min{% endif %} read
          {%- endif -%}
        </span>
        {% endif %}
        {% for t in article.topic_chips %}
        <a class="topic-chip" href="{{ topic_link_prefix }}{{ t.slug }}.html">
          {% if lang == 'ko' %}{{ t.label_ko }}{% else %}{{ t.label_en }}{% endif %}
        </a>
        {% endfor %}
      </div>
      <h2 class="article-title">
        <a href="{{ article.link }}" target="_blank" rel="noopener noreferrer">{% if lang == 'en' and article.title_en %}{{ article.title_en }}{% else %}{{ article.title }}{% endif %}</a>
      </h2>
      {# 요약은 전부 보여주고 시사점만 접는다.
         GeekNews 런칭 첫 피드백이 "스크롤이 길고 요약·시사점 분량이 많다"였다.

         처음에는 요약도 앞 2문장만 남기고 뒷부분을 이 안에 같이 접었는데, 펼치면
         라벨 없는 요약 뒷부분이 시사점보다 먼저 나와서 "시사점 보기"라는 버튼 문구와
         맞지 않았다. 요약이 문장 중간에 끊기는 것도 읽기를 방해했다. 시사점은 자체
         제목이 있는 별개 블록이라 여기가 접는 경계로 자연스럽다.

         **접었지만 색인은 그대로다.** 본문이 HTML 소스에 그대로 들어 있고
         (JS로 나중에 채우지 않는다) 구글은 모바일 우선 색인에서 아코디언에 접힌
         내용을 색인한다. 이 사이트는 FAQ에서 이미 같은 <details> 구조를 쓰고 있다.

         시사점은 이 브리핑의 핵심 가치라 접힌 상태에서도 눈에 띄어야 한다 —
         토글을 평범한 링크가 아니라 알약 모양 버튼으로 세운다. #}
      <div class="article-summary">
        <h3 class="block-label">
          {% if lang == 'ko' %}요약{% else %}Summary{% endif %}
        </h3>
        <p>{% if lang == 'ko' %}{{ article.summary_ko|safe }}{% else %}{{ article.summary_en|safe }}{% endif %}</p>
      </div>
      <details class="article-more">
        <summary class="article-more-toggle">
          <span class="article-more-label">
            {% if lang == 'ko' %}시사점 보기{% else %}Why it matters{% endif %}
          </span>
          <span class="article-more-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="article-more-body">
          <div class="article-implication">
            <h3 class="block-label">
              {% if lang == 'ko' %}이 기사가 시사하는 점{% else %}Why It Matters{% endif %}
            </h3>
            <p>{% if lang == 'ko' %}{{ article.implication_ko|safe }}{% else %}{{ article.implication_en|safe }}{% endif %}</p>
          </div>
        </div>
      </details>
      {% if article.related %}
      {# 같은 사건을 다룬 다른 매체. "몇 곳이 다뤘나"(커버리지 배지)와 달리
         "어디가 다뤘나"를 보여준다 — 한쪽 매체의 프레임만 읽지 않게 하는 장치다. #}
      <p class="article-related">
        <span class="related-label">
          {% if lang == 'ko' %}같은 사건 다른 매체{% else %}Also covered by{% endif %}
        </span>
        {% for r in article.related %}<a href="{{ r.link }}" target="_blank" rel="noopener noreferrer">{{ source_label(r.source, lang) }}</a>{% if not loop.last %}<span class="related-sep" aria-hidden="true">·</span>{% endif %}{% endfor %}
      </p>
      {% endif %}
    </article>
    {% endfor %}
  </div>

  {% if archives %}
  <section class="archive-section">
    <h2 class="archive-title">
      {% if lang == 'ko' %}지난 브리핑{% else %}Past Briefings{% endif %}
    </h2>
    <div class="archive-search">
      <input type="search" id="archive-search-input" class="archive-search-input"
             data-placeholder-ko="지난 기사 검색..." data-placeholder-en="Search past articles..."
             aria-label="지난 기사 검색 / Search past articles">
      <ul class="archive-search-results" id="archive-search-results" hidden></ul>
    </div>
    <ul class="archive-list">
      {% for a in archives %}
      <li><a href="{{ archive_link_prefix }}{{ a }}.html">{{ a }}</a></li>
      {% endfor %}
    </ul>
    {# 이 목록은 최근 60일까지만 나온다. 그보다 오래된 날짜로 가는 유일한 사람용
       경로가 이 링크다(sitemap에만 있으면 크롤러가 링크를 못 따라간다). #}
    <p class="archive-all-link">
      <a href="{{ archive_link_prefix }}index.html">
        {% if lang == 'ko' %}지난 브리핑 전체 보기 →{% else %}Browse all past briefings →{% endif %}
      </a>
    </p>
  </section>
  {% endif %}

  {% if weekly_labels %}
  <section class="archive-section archive-section--weekly">
    <h2 class="archive-title">
      {% if lang == 'ko' %}주간 회고{% else %}Weekly Recaps{% endif %}
    </h2>
    <ul class="archive-list">
      {% for w in weekly_labels %}
      <li><a href="{{ weekly_link_prefix }}{{ w }}.html">{{ w }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if faq %}
  {# 홈(/, /en/)에만 렌더링된다 — 매일 늘어나는 아카이브 페이지마다 같은 문답이
     반복되면 중복 콘텐츠이고, FAQPage 마크업도 한 URL에만 있어야 한다.
     기본은 접힌 상태(<details>)라 본문 흐름을 밀어내지 않는다. #}
  <section class="faq-section" aria-label="자주 묻는 질문" data-aria-ko="자주 묻는 질문" data-aria-en="Frequently asked questions">
    <h2 class="archive-title">
      {% if lang == 'ko' %}자주 묻는 질문{% else %}Frequently Asked{% endif %}
    </h2>
    {% for f in faq %}
    <details class="faq-item">
      <summary class="faq-question">
        {% if lang == 'ko' %}{{ f.question_ko }}{% else %}{{ f.question_en }}{% endif %}
      </summary>
      <p class="faq-answer">
        {% if lang == 'ko' %}{{ f.answer_ko }}{% else %}{{ f.answer_en }}{% endif %}
      </p>
    </details>
    {% endfor %}
  </section>
  {% endif %}
</main>

<footer class="site-footer">
  <p>
    {% if lang == 'ko' %}매일 08:00 KST 자동 생성 · 마지막 생성: {{ generated_at }}{% else %}Auto-generated daily at 08:00 KST · Last updated: {{ generated_at }}{% endif %}
  </p>
  <p class="footer-links">
    <a href="{{ feed_href }}">RSS</a>
    <span aria-hidden="true">·</span>
    <a href="{{ topic_link_prefix }}index.html">{% if lang == 'ko' %}주제별 보기{% else %}Topics{% endif %}</a>
    <span aria-hidden="true">·</span>
    <a href="{{ lang_prefix }}glossary.html">{% if lang == 'ko' %}용어사전{% else %}Glossary{% endif %}</a>
    <span aria-hidden="true">·</span>
    <a href="{{ lang_prefix }}about.html">{% if lang == 'ko' %}소개{% else %}About{% endif %}</a>
  </p>
</footer>

<div class="term-panel-backdrop" id="term-panel-backdrop" hidden></div>
<aside class="term-panel" id="term-panel" aria-hidden="true">
  <button type="button" class="term-panel-close" id="term-panel-close" aria-label="닫기 / Close">&times;</button>
  <p class="term-panel-label">
    {% if lang == 'ko' %}용어 설명{% else %}Glossary{% endif %}
  </p>
  <h3 class="term-panel-title" id="term-panel-title"></h3>
  <p class="term-panel-body" id="term-panel-body"></p>
</aside>
<script type="application/json" id="glossary-data">{{ glossary|tojson }}</script>

<script defer src="{{ css_prefix }}site.js"></script>
</body>
</html>
