<!DOCTYPE html>
{% set title_ko = "AI 용어사전 · Daily AI Thread" %}
{% set title_en = "AI Glossary · Daily AI Thread" %}
{% set desc_ko = "AI 뉴스 브리핑에 등장한 AI 용어를 쉬운 말로 설명하는 용어사전" %}
{% set desc_en = "Plain-language explanations of the AI jargon that appears in the daily briefing." %}
<html lang="{{ lang }}" data-lang="{{ lang }}"
      data-default-lang="{{ lang }}" data-asset-prefix="{{ up }}" data-archive-prefix="{{ up }}archive/">
<head>
<meta charset="UTF-8">
<title>{{ title_ko if lang == 'ko' else title_en }}</title>
<meta name="description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title_ko if lang == 'ko' else title_en }}">
<meta property="og:description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title_ko if lang == 'ko' else title_en }}">
<meta name="twitter:description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta name="robots" content="index, follow">
{% if hreflang_ko_url and hreflang_en_url %}
<link rel="alternate" hreflang="ko" href="{{ hreflang_ko_url }}">
<link rel="alternate" hreflang="en" href="{{ hreflang_en_url }}">
<link rel="alternate" hreflang="x-default" href="{{ hreflang_ko_url }}">
{% endif %}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{% if lang == 'ko' %}AI 뉴스 브리핑 · Daily AI Thread{% else %}Daily AI Thread · AI News Briefing{% endif %}">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="icon" type="image/svg+xml" href="{{ up }}favicon.svg">
<link rel="alternate" type="application/rss+xml" title="{% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}" href="{{ up }}feed.xml">
{% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
{% if naver_site_verification %}<meta name="naver-site-verification" content="{{ naver_site_verification }}">{% endif %}
<script type="application/ld+json">{{ jsonld|tojson }}</script>
<script>
(function () {
  // 테마만 처리한다. 언어는 URL이 결정하므로(한 페이지 = 한 언어) 클라이언트에서
  // 바꾸지 않는다 — 예전에는 localStorage 값으로 본문을 갈아끼웠는데, 그러면 크롤러가
  // 보는 언어와 사람이 보는 언어가 달라질 수 있다.
  function getCookie(name) {
    var match = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }
  try {
    // 처음 방문(쿠키 없음)이면 시스템 설정과 무관하게 항상 라이트 모드로 뜬다.
    var t = getCookie("theme");
    if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap">
<link rel="stylesheet" href="{{ up }}site-base.css">
<link rel="stylesheet" href="{{ up }}site-mobile.css" media="(max-width: 767px)">
<link rel="stylesheet" href="{{ up }}site-desktop.css" media="(min-width: 768px)">
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">
  {% if lang == 'ko' %}본문으로 건너뛰기{% else %}Skip to content{% endif %}
</a>
<header class="site-header">
  <div class="utility-bar">
    <a class="site-nav-link" href="{{ up }}topics/index.html">
      {% if lang == 'ko' %}주제별{% else %}Topics{% endif %}
      {% if nav_counts and nav_counts.topics %}<span class="site-nav-link-count">{{ nav_counts.topics }}</span>{% endif %}
    </a>
    <a class="site-nav-link site-nav-link-current" href="glossary.html" aria-current="page">
      {% if lang == 'ko' %}용어사전{% else %}Glossary{% endif %}
      <span class="site-nav-link-count">{{ terms|length }}</span>
    </a>
    <div class="share-wrap" id="share-wrap">
      <button id="share-button" class="share-button" type="button" aria-label="링크 복사 / Copy link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
      <!-- 비워둔 채 시작해야 한다: aria-live는 CSS 변화가 아니라 "내용이 바뀌는" 순간에만
           읽어준다. 문구를 미리 넣어두면 복사해도 스크린리더가 아무 말도 하지 않는다.
           복사 시점에 site.js가 현재 언어에 맞는 문구를 채운다. -->
      <span class="share-tooltip" id="share-tooltip" role="status" aria-live="polite"></span>
    </div>
    {# 언어 전환은 이제 상대 URL로 이동한다(한 페이지 = 한 언어). CSS로 숨기던
       방식은 크롤러가 보는 언어와 사람이 보는 언어를 어긋나게 만들 수 있었다. #}
    <a class="lang-switch" href="{{ lang_alt_url }}" hreflang="{{ 'en' if lang == 'ko' else 'ko' }}"
       rel="alternate" aria-label="{{ 'Switch to English' if lang == 'ko' else '한국어로 보기' }}">
      {% if lang == 'ko' %}EN{% else %}한국어{% endif %}
    </a>
    <button id="theme-toggle" class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="다크모드 전환" data-aria-ko="다크모드 전환" data-aria-en="Toggle dark mode">
      <span class="theme-toggle-thumb">
        <span class="icon-moon" aria-hidden="true">&#9789;</span>
        <span class="icon-sun" aria-hidden="true">&#9728;</span>
      </span>
    </button>
  </div>
  <div class="header-inner">
    <h1>
      <a href="{{ up }}index.html">
        {% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}
      </a>
    </h1>
    <p class="tagline">
      {% if lang == 'ko' %}AI 용어사전 · 지금까지 브리핑에 등장한 용어 {{ terms|length }}개{% else %}AI Glossary · {{ terms|length }} terms explained so far{% endif %}
    </p>
  </div>
</header>

<main class="content" id="main-content">
  <div class="date-bar">
    <button type="button" class="glossary-back" id="glossary-back">
      {% if lang == 'ko' %}← 이전 화면으로{% else %}← Back{% endif %}
    </button>
  </div>

  <p class="glossary-intro">
    {% if lang == 'ko' %}매일 브리핑에서 어려운 용어가 나올 때마다 쉬운 말로 설명을 덧붙여왔습니다. 그 설명들을 한곳에 모았습니다.{% else %}Every jargon term explained in a daily briefing ends up here, in plain language.{% endif %}
  </p>

  <script type="application/json" id="glossary-data">{{ term_lookup|tojson }}</script>

  <div class="glossary-search">
    <input type="search" id="glossary-search-input" class="glossary-search-input"
           data-placeholder-ko="용어 검색..." data-placeholder-en="Search terms..."
           aria-label="용어 검색 / Search terms">
  </div>

  {% if not terms %}
  <p class="empty-state">
    {% if lang == 'ko' %}아직 등록된 용어가 없습니다. 브리핑이 쌓이면 여기도 함께 채워집니다.{% else %}No terms yet — this fills in as daily briefings accumulate.{% endif %}
  </p>
  {% endif %}

  <dl class="glossary-list" id="glossary-list">
    {% for t in terms %}
    <div class="glossary-term" data-search="{{ (t.term_ko ~ ' ' ~ t.term_en)|lower }}">
      <dt class="glossary-term-name">
        {# 개별 페이지로 연결한다 — "MCP란?" 같은 질문형 검색이 목록 전체가 아니라
           해당 용어 페이지에 닿아야 한다. #}
        <a href="{{ up }}glossary/{{ t.slug }}.html">
          {% if lang == 'ko' %}{{ t.term_ko }}{% else %}{{ t.term_en }}{% endif %}
        </a>
      </dt>
      <dd class="glossary-term-desc">
        {% if lang == 'ko' %}{{ t.explanation_ko }}{% else %}{{ t.explanation_en }}{% endif %}
      </dd>
    </div>
    {% endfor %}
  </dl>
</main>

<footer class="site-footer">
  <p>
    {% if lang == 'ko' %}매일 08:00 KST 자동 갱신 · 마지막 생성: {{ generated_at }}{% else %}Auto-updated daily at 08:00 KST · Last updated: {{ generated_at }}{% endif %}
  </p>
  <p class="footer-links">
    <a href="{{ up }}feed.xml">RSS</a>
    <span aria-hidden="true">·</span>
    <a href="{{ up }}topics/index.html">{% if lang == 'ko' %}주제별 보기{% else %}Topics{% endif %}</a>
    <span aria-hidden="true">·</span>
    <a href="{{ up }}index.html">{% if lang == 'ko' %}오늘자 브리핑{% else %}Today's briefing{% endif %}</a>
  </p>
</footer>

<div class="term-panel-backdrop" id="term-panel-backdrop" hidden></div>
<aside class="term-panel" id="term-panel" aria-hidden="true">
  <button type="button" class="term-panel-close" id="term-panel-close" aria-label="닫기 / Close">&times;</button>
  <p class="term-panel-label">
    {% if lang == 'ko' %}용어 설명{% else %}Glossary{% endif %}
  </p>
  <h3 class="term-panel-title" id="term-panel-title"></h3>
  <p class="term-panel-body" id="term-panel-body"></p>
</aside>

<script defer src="{{ up }}site.js"></script>
</body>
</html>
