<!DOCTYPE html>
{# 토픽 목록(/topics/)과 토픽별 아카이브(/topics/<slug>)를 같은 템플릿으로 렌더한다 —
   크롬(유틸리티 바·언어 토글·다크모드·푸터)이 완전히 같고 본문만 다르다. is_index로 분기. #}
{% if is_index %}
{% set title_ko = "주제별 브리핑 · Daily AI Thread" %}
{% set title_en = "Browse by Topic · Daily AI Thread" %}
{% set desc_ko = "AI 뉴스 브리핑에 실린 기사를 12개 주제로 나눠 모아봅니다." %}
{% set desc_en = "Every story from the AI news briefing, grouped into 12 topics." %}
{% else %}
{% set title_ko = topic.label_ko + " · AI 뉴스 브리핑" %}
{% set title_en = topic.label_en + " · AI News Briefing" %}
{% set desc_ko = topic.description_ko %}
{% set desc_en = topic.description_en %}
{% endif %}
<html lang="ko" data-lang="ko" data-title-ko="{{ title_ko }}" data-title-en="{{ title_en }}"
      data-default-lang="ko" data-asset-prefix="../" data-archive-prefix="../archive/">
<head>
<meta charset="UTF-8">
<title>{{ title_ko }}</title>
<meta name="description" content="{{ desc_ko }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title_ko }}">
<meta property="og:description" content="{{ desc_ko }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title_ko }}">
<meta name="twitter:description" content="{{ desc_ko }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta name="robots" content="index, follow">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="AI 뉴스 브리핑 · Daily AI Thread">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="icon" type="image/svg+xml" href="../favicon.svg">
<link rel="alternate" type="application/rss+xml" title="AI 뉴스 브리핑" href="../feed.xml">
{% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
{% if naver_site_verification %}<meta name="naver-site-verification" content="{{ naver_site_verification }}">{% endif %}
<script type="application/ld+json">{{ jsonld|tojson }}</script>
<script>
(function () {
  function getCookie(name) {
    var match = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }
  try {
    var t = getCookie("theme");
    if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
    var l = localStorage.getItem("lang");
    if (l === "ko" || l === "en") {
      document.documentElement.setAttribute("data-lang", l);
      document.documentElement.setAttribute("lang", l);
      var titleAttr = l === "en" ? "data-title-en" : "data-title-ko";
      var storedTitle = document.documentElement.getAttribute(titleAttr);
      if (storedTitle) document.title = storedTitle;
    }
  } catch (e) {}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap">
<link rel="stylesheet" href="../site-base.css">
<link rel="stylesheet" href="../site-mobile.css" media="(max-width: 767px)">
<link rel="stylesheet" href="../site-desktop.css" media="(min-width: 768px)">
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">
  <span class="lang-ko">본문으로 건너뛰기</span>
  <span class="lang-en">Skip to content</span>
</a>
<header class="site-header">
  <div class="utility-bar">
    <a class="glossary-nav-link" href="../glossary.html">
      <span class="lang-ko">용어사전</span>
      <span class="lang-en">Glossary</span>
    </a>
    <div class="share-wrap" id="share-wrap">
      <button id="share-button" class="share-button" type="button" aria-label="링크 복사 / Copy link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
      <span class="share-tooltip" id="share-tooltip" role="status" aria-live="polite"></span>
    </div>
    <div class="lang-select" id="lang-select">
      <button type="button" class="lang-select-trigger" id="lang-select-trigger" aria-haspopup="listbox" aria-expanded="false">
        <span class="lang-select-current lang-ko">한국어</span>
        <span class="lang-select-current lang-en">English</span>
        <span class="lang-select-caret" aria-hidden="true">▾</span>
      </button>
      <ul class="lang-select-list" id="lang-select-list" role="listbox" hidden>
        <li role="option" tabindex="-1" data-lang-value="ko">한국어</li>
        <li role="option" tabindex="-1" data-lang-value="en">English</li>
      </ul>
    </div>
    <button id="theme-toggle" class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="다크모드 전환" data-aria-ko="다크모드 전환" data-aria-en="Toggle dark mode">
      <span class="theme-toggle-thumb">
        <span class="icon-moon" aria-hidden="true">&#9789;</span>
        <span class="icon-sun" aria-hidden="true">&#9728;</span>
      </span>
    </button>
  </div>
  <div class="header-inner">
    <h1>
      <a href="../index.html">
        <span class="lang-ko">AI 뉴스 브리핑</span>
        <span class="lang-en">AI News Briefing</span>
      </a>
    </h1>
    <p class="tagline">
      {% if is_index %}
      <span class="lang-ko">주제별 브리핑 · 12개 주제로 모아 보기</span>
      <span class="lang-en">Browse by topic · 12 topics</span>
      {% else %}
      <span class="lang-ko">{{ topic.label_ko }} · 기사 {{ entries|length }}건</span>
      <span class="lang-en">{{ topic.label_en }} · {{ entries|length }} stories</span>
      {% endif %}
    </p>
  </div>
</header>

<main class="content" id="main-content">
  <div class="date-bar">
    <a class="back-link" href="../index.html">
      <span class="lang-ko">← 오늘자 브리핑</span>
      <span class="lang-en">← Today's briefing</span>
    </a>
    {% if not is_index %}
    <a class="back-link" href="index.html">
      <span class="lang-ko">모든 주제 보기</span>
      <span class="lang-en">All topics</span>
    </a>
    {% endif %}
  </div>

  <p class="glossary-intro">
    {% if is_index %}
    <span class="lang-ko">지금까지 브리핑에 실린 기사를 주제별로 나눠 모았습니다. 하나의 흐름을 처음부터 따라 읽고 싶을 때 쓰세요.</span>
    <span class="lang-en">Every story published so far, grouped by subject — useful when you want to follow one thread from the beginning.</span>
    {% else %}
    <span class="lang-ko">{{ topic.description_ko }}</span>
    <span class="lang-en">{{ topic.description_en }}</span>
    {% endif %}
  </p>

  {# 토픽 네비게이션은 목록 페이지와 개별 페이지 양쪽에 둔다 — 개별 페이지에 들어온
     검색 유입이 다른 주제로 넘어갈 수 있어야 페이지들이 서로 고립되지 않는다. #}
  <nav class="topic-nav" aria-label="주제 목록" data-aria-ko="주제 목록" data-aria-en="Topic list">
    {% for t in topic_summary %}
    {% if t.count %}
    <a class="topic-nav-item{% if not is_index and t.slug == topic.slug %} topic-nav-item-current{% endif %}"
       href="{{ t.slug }}.html"{% if not is_index and t.slug == topic.slug %} aria-current="page"{% endif %}>
      <span class="lang-ko">{{ t.label_ko }}</span>
      <span class="lang-en">{{ t.label_en }}</span>
      <span class="topic-nav-count">{{ t.count }}</span>
    </a>
    {% else %}
    <span class="topic-nav-item topic-nav-item-empty">
      <span class="lang-ko">{{ t.label_ko }}</span>
      <span class="lang-en">{{ t.label_en }}</span>
      <span class="topic-nav-count">0</span>
    </span>
    {% endif %}
    {% endfor %}
  </nav>

  {% if not is_index %}
  <ol class="topic-entries">
    {% for e in entries %}
    <li class="topic-entry">
      <div class="article-meta">
        <a class="topic-entry-date" href="../archive/{{ e.date }}.html">{{ e.date }}</a>
        <span class="source">{{ e.source }}</span>
      </div>
      <h2 class="topic-entry-title"><a href="{{ e.link }}" target="_blank" rel="noopener noreferrer">{{ e.title }}</a></h2>
      <p class="topic-entry-summary">
        <span class="lang-ko">{{ e.summary_ko }}</span>
        <span class="lang-en">{{ e.summary_en }}</span>
      </p>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</main>

<footer class="site-footer">
  <p>
    <span class="lang-ko">매일 08:00 KST 자동 갱신 · 마지막 생성: {{ generated_at }}</span>
    <span class="lang-en">Auto-updated daily at 08:00 KST · Last updated: {{ generated_at }}</span>
  </p>
  <p class="footer-links">
    <a href="../feed.xml">RSS</a>
    <span aria-hidden="true">·</span>
    <a href="../glossary.html"><span class="lang-ko">용어사전</span><span class="lang-en">Glossary</span></a>
    <span aria-hidden="true">·</span>
    <a href="index.html"><span class="lang-ko">주제별 보기</span><span class="lang-en">Topics</span></a>
  </p>
</footer>

<script defer src="../site.js"></script>
</body>
</html>
