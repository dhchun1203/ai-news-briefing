<!DOCTYPE html>
{# 토픽 목록(/topics/)과 토픽별 아카이브(/topics/<slug>)를 같은 템플릿으로 렌더한다 —
   크롬(유틸리티 바·언어 토글·다크모드·푸터)이 완전히 같고 본문만 다르다. is_index로 분기. #}
{% if is_index %}
{% set title_ko = "주제별 브리핑 · Daily AI Thread" %}
{% set title_en = "Browse by Topic · Daily AI Thread" %}
{% set desc_ko = "AI 뉴스 브리핑에 실린 기사를 12개 주제로 나눠 모아봅니다." %}
{% set desc_en = "Every story from the AI news briefing, grouped into 12 topics." %}
{% else %}
{% set title_ko = topic.label_ko + " · AI 뉴스 브리핑" %}
{% set title_en = topic.label_en + " · AI News Briefing" %}
{% set desc_ko = topic.description_ko %}
{% set desc_en = topic.description_en %}
{% endif %}
{# 이 템플릿은 두 가지 다른 URL 깊이를 함께 렌더한다 — 목록 페이지(/topics, cleanUrls가
   index.html을 벗겨내 세그먼트 1개·슬래시 없음이 되므로 상대경로 기준 디렉터리가 루트다,
   /glossary와 같은 깊이)와 개별 페이지(/topics/<slug>, 세그먼트 2개, /archive/<날짜>와
   같은 깊이)다. 예전엔 항상 "한 단계 아래"로 가정해 하드코딩했는데, 목록 페이지에서
   `../`가 없는 형제 링크(예: href="agents.html")만 루트 기준으로 잘못 풀려 404가 났다
   (`../`가 붙은 나머지는 루트에서 클램핑돼 우연히 맞았을 뿐이다). p/tp로 깊이별
   접두사를 분리해 이 클래스의 버그를 다시 만들지 않는다. #}
<html lang="{{ lang }}" data-lang="{{ lang }}"
      data-default-lang="{{ lang }}" data-asset-prefix="{{ up }}" data-archive-prefix="{{ lup }}archive/">
<head>
<meta charset="UTF-8">
<title>{{ title_ko if lang == 'ko' else title_en }}</title>
<meta name="description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title_ko if lang == 'ko' else title_en }}">
<meta property="og:description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title_ko if lang == 'ko' else title_en }}">
<meta name="twitter:description" content="{{ desc_ko if lang == 'ko' else desc_en }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta name="robots" content="index, follow">
{% if hreflang_ko_url and hreflang_en_url %}
<link rel="alternate" hreflang="ko" href="{{ hreflang_ko_url }}">
<link rel="alternate" hreflang="en" href="{{ hreflang_en_url }}">
<link rel="alternate" hreflang="x-default" href="{{ hreflang_ko_url }}">
{% endif %}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{% if lang == 'ko' %}AI 뉴스 브리핑 · Daily AI Thread{% else %}Daily AI Thread · AI News Briefing{% endif %}">
<meta name="twitter:image" content="{{ og_image_url }}">
<link rel="icon" type="image/svg+xml" href="{{ up }}favicon.svg">
<link rel="alternate" type="application/rss+xml" title="{% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}" href="{{ lup }}feed.xml">
{% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
{% if naver_site_verification %}<meta name="naver-site-verification" content="{{ naver_site_verification }}">{% endif %}
<script type="application/ld+json">{{ jsonld|tojson }}</script>
<script>
(function () {
  // 테마만 처리한다. 언어는 URL이 결정하므로(한 페이지 = 한 언어) 클라이언트에서
  // 바꾸지 않는다 — 예전에는 localStorage 값으로 본문을 갈아끼웠는데, 그러면 크롤러가
  // 보는 언어와 사람이 보는 언어가 달라질 수 있다.
  function getCookie(name) {
    var match = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
    return match ? decodeURIComponent(match[1]) : null;
  }
  try {
    // 처음 방문(쿠키 없음)이면 시스템 설정과 무관하게 항상 라이트 모드로 뜬다.
    var t = getCookie("theme");
    if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap">
<link rel="stylesheet" href="{{ up }}site-base.css">
<link rel="stylesheet" href="{{ up }}site-mobile.css" media="(max-width: 767px)">
<link rel="stylesheet" href="{{ up }}site-desktop.css" media="(min-width: 768px)">
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">
  {% if lang == 'ko' %}본문으로 건너뛰기{% else %}Skip to content{% endif %}
</a>
<header class="site-header">
  {% set nav_p = lup %}
  {% set nav_current = 'topics' %}
  {% include '_utility-bar.html.j2' %}
  <div class="header-inner">
    <h1>
      <a href="{{ lup }}index.html">
        {% if lang == 'ko' %}AI 뉴스 브리핑{% else %}AI News Briefing{% endif %}
      </a>
    </h1>
    <p class="tagline">
      {% if is_index %}
      {% if lang == 'ko' %}주제별 브리핑 · 12개 주제로 모아 보기{% else %}Browse by topic · 12 topics{% endif %}
      {% else %}
      {% if lang == 'ko' %}{{ topic.label_ko }} · 기사 {{ entries|length }}건{% else %}{{ topic.label_en }} · {{ entries|length }} stories{% endif %}
      {% endif %}
    </p>
  </div>
</header>

<main class="content" id="main-content">
  <div class="date-bar">
    <a class="back-link" href="{{ lup }}index.html">
      {% if lang == 'ko' %}← 오늘자 브리핑{% else %}← Today's briefing{% endif %}
    </a>
    {% if not is_index %}
    <a class="back-link" href="{{ tp }}index.html">
      {% if lang == 'ko' %}모든 주제 보기{% else %}All topics{% endif %}
    </a>
    {% endif %}
  </div>

  <p class="glossary-intro">
    {% if is_index %}
    {% if lang == 'ko' %}지금까지 브리핑에 실린 기사를 주제별로 나눠 모았습니다. 하나의 흐름을 처음부터 따라 읽고 싶을 때 쓰세요.{% else %}Every story published so far, grouped by subject — useful when you want to follow one thread from the beginning.{% endif %}
    {% else %}
    {% if lang == 'ko' %}{{ topic.description_ko }}{% else %}{{ topic.description_en }}{% endif %}
    {% endif %}
  </p>

  {# 토픽 네비게이션은 목록 페이지와 개별 페이지 양쪽에 둔다 — 개별 페이지에 들어온
     검색 유입이 다른 주제로 넘어갈 수 있어야 페이지들이 서로 고립되지 않는다. #}
  <nav class="topic-nav" aria-label="주제 목록" data-aria-ko="주제 목록" data-aria-en="Topic list">
    {% for t in topic_summary %}
    {% if t.count %}
    <a class="topic-nav-item{% if not is_index and t.slug == topic.slug %} topic-nav-item-current{% endif %}"
       href="{{ tp }}{{ t.slug }}.html"{% if not is_index and t.slug == topic.slug %} aria-current="page"{% endif %}>
      {% if lang == 'ko' %}{{ t.label_ko }}{% else %}{{ t.label_en }}{% endif %}
      <span class="topic-nav-count">{{ t.count }}</span>
    </a>
    {% else %}
    <span class="topic-nav-item topic-nav-item-empty">
      {% if lang == 'ko' %}{{ t.label_ko }}{% else %}{{ t.label_en }}{% endif %}
      <span class="topic-nav-count">0</span>
    </span>
    {% endif %}
    {% endfor %}
  </nav>

  {% if not is_index %}
  <ol class="topic-entries">
    {% for e in entries %}
    <li class="topic-entry">
      <div class="article-meta">
        <a class="topic-entry-date" href="{{ lup }}archive/{{ e.date }}.html">{{ e.date }}</a>
        <span class="source">{{ e.source }}</span>
      </div>
      <h2 class="topic-entry-title"><a href="{{ e.link }}" target="_blank" rel="noopener noreferrer">{% if lang == 'en' and e.title_en %}{{ e.title_en }}{% else %}{{ e.title }}{% endif %}</a></h2>
      <p class="topic-entry-summary">
        {% if lang == 'ko' %}{{ e.summary_ko }}{% else %}{{ e.summary_en }}{% endif %}
      </p>
    </li>
    {% endfor %}
  </ol>
  {% endif %}
</main>

<footer class="site-footer">
  <p>
    {% if lang == 'ko' %}매일 08:00 KST 자동 갱신 · 마지막 생성: {{ generated_at }}{% else %}Auto-updated daily at 08:00 KST · Last updated: {{ generated_at }}{% endif %}
  </p>
  <p class="footer-links">
    <a href="{{ lup }}feed.xml">RSS</a>
    <span aria-hidden="true">·</span>
    <a href="{{ lup }}glossary.html">{% if lang == 'ko' %}용어사전{% else %}Glossary{% endif %}</a>
    <span aria-hidden="true">·</span>
    <a href="{{ tp }}index.html">{% if lang == 'ko' %}주제별 보기{% else %}Topics{% endif %}</a>
  </p>
</footer>

<script defer src="{{ up }}site.js"></script>
</body>
</html>
